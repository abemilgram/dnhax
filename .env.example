# Optional reconstruction; see MACOS.md for Apple Silicon or README.md for CUDA.
VGGT_OMEGA_CHECKPOINT=/absolute/path/to/model.pt
# SIMV1_DATA=/absolute/path/to/workspace-data

# auto prefers CUDA, then Apple MPS, then CPU. Explicit device errors do not fall back.
SIMV1_DEVICE=auto
# Defaults: CUDA 24, MPS 8, CPU 2. Start small when testing on a Mac.
# SIMV1_MAX_FRAMES=8
