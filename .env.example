# Video-to-3D reconstruction is AMB3R-only and fails on any model/configuration error.
SIMV1_MODEL=amb3r
# AMB3R is CUDA-only. Use Dockerfile.amb3r or provision all pinned dependencies.
# AMB3R_CHECKPOINT=/workspace/models/amb3r/amb3r.pt
# AMB3R_ROOT=/opt/amb3r
# SIMV1_DATA=/absolute/path/to/workspace-data

# AMB3R reconstruction requires NVIDIA CUDA; CPU and Apple MPS are unsupported.
SIMV1_DEVICE=cuda
# 0 / unset is unlimited (every 1 fps frame). Set a small integer to cap GPU memory.
# SIMV1_MAX_FRAMES=0
# Joint jobs select across both full clips, independently of the single-capture limit.
# 0 / unset is unlimited. Set an integer of at least 2 to cap each source.
# SIMV1_JOINT_FRAMES_PER_SOURCE=0

# Live inference watchdog (seconds); batch size is chosen when creating a session.
SIMV1_LIVE_JOB_TIMEOUT=900
# 0 disables scheduled cleanup. The RunPod image defaults to 24 hours.
SIMV1_RETENTION_HOURS=0
